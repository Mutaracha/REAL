// REAL — внешний файл настроек. Создаётся автоматически рядом с REAL.exe и
// одновременно служит справкой: у каждого параметра есть комментарий.
//
// Приоритет: командная строка > этот файл > встроенные значения по умолчанию.
// Справка по ключам командной строки: REAL.exe --help
// Разбор всех устройств и периодов:  REAL.exe --diagnose
// Полная справочная документация:    docs/CONFIG.md
//
// Настройки REAL. Файл создаётся автоматически и читается при запуске и перезагрузке настроек. Комментарии можно удалять.
{
  "configVersion": 1,
  "commentLanguage": "ru",

  "application": {  // Окно, запуск и автозапуск приложения.
    "language": "auto",  // Язык интерфейса, журнала и этих комментариев: "auto" (язык Windows), "en", "ru". При смене языка комментарии перезаписываются при следующем запуске, значения сохраняются.
    "startMinimizedToTray": false,  // true - стартовать сразу свёрнутым в трей (то же, что ключ запуска --tray).
    "minimizeToTray": true,  // true - кнопка "Свернуть" прячет окно в трей, а не в панель задач.
    "closeButtonAction": "minimize",  // Что делает крестик окна: "minimize" (в трей) или "exit" (завершить программу).
    "startWithWindows": false  // true - автозапуск при входе в систему (запись REAL в HKCU Run).
  },

  "tray": {  // Значок в системном трее.
    "enabled": true,  // true - показывать значок в трее (левый клик - окно, правый - меню).
    "notifications": {  // Всплывающие уведомления.
      "onError": true,  // true - уведомлять об ошибках (не чаще одного сообщения в минуту).
      "onDeviceChange": true,  // true - уведомлять о смене аудиоустройства.
      "onStateChange": false  // true - уведомлять о включении и выключении режима.
    },
    "menu": {  // Пункты меню значка, которые можно скрыть (false - пункт скрыт); строка состояния, "Настройки" и "Выход" есть всегда.
      "toggleEnabled": true,  // Пункт "REAL запущен": включает и выключает снижение задержки.
      "reinitialize": true,  // Пункт "Перезапустить": аудиопотоки создаются заново.
      "openLog": true,  // Пункт открытия журнала.
      "diagnostics": true  // Пункт создания отчёта об аудиоустройствах.
    }
  },

  "audio": {  // Параметры работы с аудиодвижком.
    "dataFlow": "render",  // Какие устройства обрабатывать: "render" (воспроизведение), "capture" (запись), "both".
    "periodSelection": "min",  // Какой буфер запрашивать: "min" - минимальный период устройства; "fundamental" - он же, выровненный по базовому шагу движка (сам шаг периодом не является, поэтому меньше минимального не запрашивается никогда); "fixed" - ровно столько фреймов, сколько указано в requestedPeriodFrames.
    "requestedPeriodFrames": 0,  // Буфер во фреймах, который запрашивает "fixed": округляется по базовому шагу движка и удерживается в поддерживаемом устройством диапазоне (0 - минимальный период устройства).
    "reinit": {  // Когда перезапускать автоматически (аудиопотоки создаются заново).
      "defaultDeviceChanged": true,  // Сменилось устройство по умолчанию (основной случай).
      "deviceStateChanged": true,  // Устройство стало активным или неактивным (включение наушников).
      "deviceAdded": true,  // Подключено новое устройство.
      "deviceRemoved": false,  // Устройство удалено.
      "resumeFromSleep": true,  // Выход из сна или Modern Standby.
      "sessionUnlock": true,  // Разблокировка сеанса (Win+L).
      "enableWhenDisabled": true,  // true - при смене устройства включать снижение задержки, если оно было выключено.
      "failureTimeoutMs": 60000,  // Сколько миллисекунд повторять попытки, прежде чем выключить режим и прекратить опрос.
      "debounceMs": 1000  // Пауза перед перезапуском: Windows присылает пачку событий подряд (мс).
    }
  },

  "performance": {  // Сам процесс REAL. На звук не влияет: звук обрабатывает служба Windows Audio.
    "processPriority": "normal"  // Приоритет процесса как в диспетчере задач: "normal" (обычный), "belowNormal" (ниже среднего), "idle" (низкий).
  },

  "updates": {  // Проверка обновлений. По умолчанию выключена; во время работы запросов нет.
    "checkOnStartup": false  // true - один раз проверить обновления при запуске; false - ни одного сетевого запроса.
  },

  "hotkeys": {  // Глобальные горячие клавиши.
    "enabled": true,  // true - регистрировать горячие клавиши.
    "toggleEnabled": "Ctrl+Alt+L",  // Включить и выключить режим. Клавиши: Ctrl, Alt, Shift, Win, A-Z, 0-9, F1-F24.
    "reinitialize": "Ctrl+Alt+R"  // Перезапустить: заново создать аудиопотоки.
  },

  "logging": {  // Файл журнала. В окне программы всегда видны основные операции уровня info.
    "level": "info",  // "off" - файл не ведётся совсем; "error", "warn", "info", "debug", "trace" - от самого краткого файла к самому подробному.
    "filePath": "REAL.log",  // Путь к журналу: относительно каталога REAL.exe или абсолютный.
    "maxFileSizeMb": 1,  // Размер файла журнала до ротации (МБ).
    "maxFiles": 3  // Сколько файлов журнала хранить.
  }
}

