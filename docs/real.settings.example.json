// REAL — внешний файл настроек. Создаётся автоматически рядом с REAL.exe и
// одновременно служит справкой: у каждого параметра есть комментарий.
//
// Приоритет: командная строка > этот файл > встроенные значения по умолчанию.
// Справка по ключам командной строки: REAL.exe --help
// Разбор всех устройств и буферов:   REAL.exe --diagnose
// Полная справочная документация:    docs/CONFIG.md
//
// Настройки REAL. Файл создаётся автоматически и читается при запуске и перезагрузке настроек. Комментарии можно удалять.
{
  "configVersion": 1,
  "commentLanguage": "ru",

  "application": {  // Окно, запуск и автозапуск приложения.
    "language": "auto",  // Язык интерфейса, журнала и этих комментариев: "auto" (язык Windows), "en", "ru". Комментарии переписываются на новом языке: сразу при смене в окне настроек, при правке этого файла - при следующем запуске; значения сохраняются.
    "startMinimizedToTray": false,  // true - стартовать сразу свёрнутым в трей (то же, что ключ запуска --tray); нужен значок в трее.
    "minimizeToTray": true,  // true - кнопка "Свернуть" прячет окно в трей, а не в панель задач; нужен значок в трее.
    "closeButtonAction": "exit",  // Что делает крестик окна: "minimize" (в трей) или "exit" (завершить программу); без значка в трее - всегда завершает.
    "startWithWindows": false  // true - автозапуск при входе в систему (запись REAL в HKCU Run).
  },

  "tray": {  // Значок в системном трее.
    "enabled": true,  // true - показывать значок в трее (левый клик - окно, правый - меню).
    "notifications": {  // Всплывающие уведомления: показываются, только когда окно программы скрыто или свёрнуто.
      "onError": true,  // true - уведомлять об ошибках (одно уведомление на сбой, а не на каждую попытку).
      "onDeviceChange": true,  // true - уведомлять о смене устройства.
      "onStateChange": true  // true - уведомлять о включении и выключении снижения задержки (и о ручном перезапуске).
    },
    "menu": {  // Пункты меню значка, которые можно скрыть (false - пункт скрыт); строка состояния, "Настройки" и "Выход" есть всегда.
      "toggleEnabled": true,  // Пункт "REAL запущен": включает и выключает снижение задержки.
      "reinitialize": true,  // Пункт "Перезапустить": аудиопотоки создаются заново.
      "openLog": true,  // Пункт "Файл журнала": открывает журнал.
      "diagnostics": true  // Пункт "Диагностика": отчёт об аудиоустройствах.
    }
  },

  "audio": {  // Параметры работы с аудиодвижком.
    "dataFlow": "render",  // Какие устройства обрабатывать: "render" (воспроизведение), "capture" (запись), "both" (воспроизведение и запись).
    "buffer": "min",  // Буфер: "min" - минимальный, который поддерживает драйвер устройства; "fixed" - фиксированный, размер в fixedBufferFrames.
    "fixedBufferFrames": 0,  // Размер фиксированного буфера во фреймах, только для "fixed": от минимального до максимального буфера устройства с его базовым шагом (см. отчёт диагностики); неподходящее значение подгоняется, о чём пишется в журнал. 0 - не задан.
    "reinit": {  // Когда перезапускать автоматически (аудиопотоки создаются заново).
      "defaultDeviceChanged": true,  // Смена устройства по умолчанию (основной случай).
      "deviceStateChanged": true,  // Подключение и отключение устройства: оно стало активным или неактивным (наушники, USB).
      "deviceAdded": false,  // Появление нового устройства, которого раньше не было в системе (знакомое устройство при повторном подключении относится к deviceStateChanged).
      "deviceRemoved": false,  // Удаление устройства из системы.
      "resumeFromSleep": true,  // Выход из сна или Modern Standby.
      "sessionUnlock": true,  // Разблокировка сеанса (Win+L).
      "enableWhenDisabled": true,  // true - при смене устройства включать снижение задержки, если оно было выключено.
      "failureTimeoutMs": 60000,  // Сколько миллисекунд повторять попытки, прежде чем выключить снижение задержки и прекратить опрос (5000–3600000).
      "debounceMs": 1000  // Пауза перед перезапуском: Windows присылает пачку событий подряд (мс, 500–60000).
    }
  },

  "performance": {  // Сам процесс REAL. На звук не влияет: звук обрабатывает служба Windows Audio.
    "processPriority": "normal"  // Приоритет процесса как в диспетчере задач: "normal" (обычный), "belowNormal" (ниже среднего), "idle" (низкий).
  },

  "updates": {  // Проверка обновлений: не больше одного раза при запуске, во время работы запросов нет.
    "checkOnStartup": true  // true - один раз проверить обновления при запуске; false - ни одного сетевого запроса.
  },

  "logging": {  // Файл журнала. В окне программы всегда видны основные операции уровня info.
    "level": "off",  // "off" - файл не ведётся совсем; "error", "warn", "info", "debug", "trace" - от самого краткого файла к самому подробному.
    "filePath": "REAL.log",  // Путь к файлу журнала: относительно каталога REAL.exe или абсолютный.
    "maxFileSizeMb": 1,  // Размер одного файла журнала, после которого начинается следующий (МБ, 1–1024).
    "maxFiles": 3  // Сколько файлов журнала хранить (1–100).
  }
}

