// REAL — внешний файл настроек (пример со всеми ключами и пояснениями).
//
// Расположение: рядом с REAL.exe, имя файла — real.settings.json
// Кодировка: UTF-8 (BOM допускается). Комментарии // и /* */ поддерживаются.
//
// Приоритет: командная строка > этот файл > встроенные значения по умолчанию.
// Полный справочник: docs/CONFIG.md
{
  "configVersion": 1,

  // ── Приложение и окно ────────────────────────────────────────────────────
  "application": {
    "startMinimizedToTray": false,   // стартовать свёрнутым в трей (аналог --tray)
    "minimizeToTray": true,          // «свернуть» прячет окно в трей
    "closeButtonAction": "minimize", // minimize | exit — поведение крестика
    "showConsole": false,            // true — дополнительно окно консоли с журналом
    "singleInstance": true,          // одна копия; REAL.exe --reinit передаст команду ей
    "startWithWindows": false        // автозапуск (HKCU\...\Run)
  },

  // ── Значок в трее ────────────────────────────────────────────────────────
  "tray": {
    "enabled": true,
    "showStatusInTooltip": true,     // подсказка «REAL - 2.67 ms - Speakers (Realtek)»
    "notifications": {
      "onError": true,               // уведомление об ошибке
      "onDeviceChange": true,        // уведомление о смене устройства
      "onStateChange": false         // уведомление о вкл/выкл
    },
    "menu": {
      "showStatus": true,            // строка со статусом в меню
      "toggleEnabled": true,         // пункт «включено»
      "reinitialize": true,          // ручная переинициализация
      "openSettings": true,          // открыть этот файл
      "openLog": true,               // открыть журнал
      "checkForUpdates": true,       // виден только если updates.mode != "off"
      "startWithWindows": true,      // переключатель автозапуска
      "about": true,
      "exit": true
    }
  },

  // ── Аудио (ядро утилиты) ─────────────────────────────────────────────────
  "audio": {
    "enabledOnStartup": true,

    "dataFlow": "render",            // render | capture | both
    "role": "console",               // console | multimedia | communications

    "periodSelection": "min",        // min | fundamental | fixed
    "requestedPeriodFrames": 0,      // для "fixed": период в кадрах (0 = решает приложение)
    "allowPeriodSnap": true,         // принять период, уже зафиксированный другим приложением
    "releaseOnExit": true,           // снять поток при выходе

    // Когда переинициализировать потоки автоматически
    "reinit": {
      "defaultDeviceChanged": true,  // основное: смена устройства по умолчанию
      "deviceStateChanged": true,    // устройство стало активным/неактивным
      "deviceAdded": false,          // новое устройство
      "deviceRemoved": false,        // устройство удалено
      "resumeFromSleep": true,       // выход из сна / Modern Standby
      "sessionUnlock": true,         // разблокировка сеанса
      "debounceMs": 1000             // антидребезг (Windows шлёт пачку событий)
    }
  },

  // ── Побочные эффекты низкой задержки ─────────────────────────────────────
  "performance": {
    "processPriority": "normal",     // normal | belowNormal | idle
    "disablePowerThrottling": true   // Windows 11: снять троттлинг, чтобы не «занимать» ядро CPU
  },

  // ── Обновления ───────────────────────────────────────────────────────────
  "updates": {
    "mode": "off",                   // off | manual   (off — ни одного сетевого запроса)
    "repository": "Mutaracha/REAL",  // откуда смотреть релизы
    "timeoutSeconds": 15,
    "checkOnStartup": false          // проверять при запуске (только при mode = "manual")
  },

  // ── Глобальные горячие клавиши ───────────────────────────────────────────
  "hotkeys": {
    "enabled": true,
    "toggleEnabled": "Ctrl+Alt+L",   // вкл/выкл снижение задержки
    "reinitialize": "Ctrl+Alt+R"     // переинициализация
  },

  // ── Журнал ───────────────────────────────────────────────────────────────
  "logging": {
    "level": "info",                 // trace | debug | info | warn | error | off
    "toConsole": false,
    "toFile": true,
    "filePath": "REAL.log",          // относительно каталога exe или абсолютный путь
    "maxFileSizeMb": 1,
    "maxFiles": 3
  }
}
