// REAL — внешний файл настроек. Создаётся автоматически рядом с REAL.exe и
// одновременно служит справкой: у каждого параметра есть комментарий.
//
// Приоритет: командная строка > этот файл > встроенные значения по умолчанию.
// Справка по ключам командной строки: REAL.exe --help
// Разбор всех устройств и периодов:  REAL.exe --diagnose
// Полная справочная документация:    docs/CONFIG.md
//
{
  // Версия формата настроек, служебное поле. Текущая версия: 1.
  "configVersion": 1,

  // Окно, запуск и автозапуск приложения.
  "application": {
    // true — стартовать сразу свёрнутым в трей (то же, что ключ запуска --tray).
    "startMinimizedToTray": false,
    // true — кнопка «Свернуть» прячет окно в трей, а не в панель задач.
    "minimizeToTray": true,
    // Что делает крестик окна: "minimize" (в трей) или "exit" (завершить программу).
    "closeButtonAction": "minimize",
    // true — дополнительно открыть окно консоли с журналом (то же, что --console).
    "showConsole": false,
    // true — одна копия: повторный запуск передаёт команду работающей (--reinit, --exit и т.д.).
    "singleInstance": true,
    // true — автозапуск при входе в систему (запись REAL в HKCU\...\Run).
    "startWithWindows": false
  },

  // Значок в системном трее.
  "tray": {
    // true — показывать значок в трее (левый клик — окно, правый — меню).
    "enabled": true,
    // true — показывать текущий размер буфера в подсказке значка.
    "showStatusInTooltip": true,
    // Всплывающие уведомления.
    "notifications": {
      // true — уведомлять об ошибках включения низкой задержки.
      "onError": true,
      // true — уведомлять о смене аудиоустройства.
      "onDeviceChange": true,
      // true — уведомлять о включении/выключении режима.
      "onStateChange": false
    },
    // Состав меню значка (false — пункт скрыт).
    "menu": {
      // Строка с текущим статусом первой строкой меню.
      "showStatus": true,
      // Пункт «Latency reduction enabled» (включить/выключить режим).
      "toggleEnabled": true,
      // Пункт «Reinitialize now» (переинициализация без перезапуска).
      "reinitialize": true,
      // Пункт «Settings file...» — открыть этот файл настроек.
      "openSettings": true,
      // Пункт «Open log» — открыть журнал.
      "openLog": true,
      // Пункт-переключатель автозапуска.
      "startWithWindows": true,
      // Пункт «About REAL».
      "about": true,
      // Пункт «Exit» — завершить программу.
      "exit": true
    }
  },

  // Параметры работы с аудиодвижком.
  "audio": {
    // true — включать снижение задержки сразу при запуске.
    "enabledOnStartup": true,
    // Какие устройства обрабатывать: "render" (воспроизведение), "capture" (запись), "both".
    "dataFlow": "render",
    // Роль устройства по умолчанию: "console", "multimedia", "communications".
    "role": "console",
    // Какой буфер запрашивать: "min" (минимальный), "fundamental" (базовый), "fixed" (см. ниже).
    "periodSelection": "min",
    // Размер буфера в кадрах для periodSelection = "fixed" (0 — значение по умолчанию).
    "requestedPeriodFrames": 0,
    // true — если буфер уже зафиксирован другим приложением, принять его, а не сообщать об ошибке.
    "allowPeriodSnap": true,
    // true — освобождать аудиопоток при выходе (движок сам вернётся к 10 мс).
    "releaseOnExit": true,
    // Когда переинициализировать потоки автоматически.
    "reinit": {
      // Сменилось устройство по умолчанию (основной случай).
      "defaultDeviceChanged": true,
      // Устройство стало активным или неактивным (выключение/включение наушников).
      "deviceStateChanged": true,
      // Подключено новое устройство.
      "deviceAdded": false,
      // Устройство удалено.
      "deviceRemoved": false,
      // Выход из сна / Modern Standby.
      "resumeFromSleep": true,
      // Разблокировка сеанса (Win+L).
      "sessionUnlock": true,
      // Пауза перед переинициализацией: Windows присылает пачку событий подряд (мс).
      "debounceMs": 1000
    }
  },

  // Побочные эффекты низкой задержки.
  "performance": {
    // Приоритет процесса: "normal", "belowNormal" или "idle".
    "processPriority": "normal",
    // true — снять троттлинг скорости исполнения (Windows 11), чтобы аудиопоток не «занимал» ядро CPU.
    "disablePowerThrottling": true
  },

  // Проверка обновлений. По умолчанию полностью выключена.
  "updates": {
    // "off" — ни одного сетевого запроса; "manual" — проверка только при запуске, если включён checkOnStartup.
    "mode": "off",
    // Репозиторий GitHub, из которого берутся релизы (owner/name).
    "repository": "Mutaracha/REAL",
    // true — один раз проверить обновления при запуске (только при mode = "manual").
    "checkOnStartup": false
  },

  // Глобальные горячие клавиши.
  "hotkeys": {
    // true — регистрировать горячие клавиши.
    "enabled": true,
    // Включить/выключить режим. Клавиши: Ctrl, Alt, Shift, Win, A-Z, 0-9, F1-F24.
    "toggleEnabled": "Ctrl+Alt+L",
    // Переинициализировать аудиопотоки.
    "reinitialize": "Ctrl+Alt+R"
  },

  // Журнал работы программы.
  "logging": {
    // Подробность: "trace", "debug", "info", "warn", "error", "off".
    "level": "info",
    // true — дублировать журнал в консоль (нужен showConsole или ключ --console).
    "toConsole": false,
    // true — писать файл журнала.
    "toFile": true,
    // Путь к журналу: относительно каталога REAL.exe или абсолютный.
    "filePath": "REAL.log",
    // Размер файла журнала до ротации (МБ).
    "maxFileSizeMb": 1,
    // Сколько файлов журнала хранить.
    "maxFiles": 3
  }
}

